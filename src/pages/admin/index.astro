---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AuthGuard from '../../components/admin/AuthGuard.svelte';
---

<AdminLayout title="Admin — Portfolio ChrisBP">
  <AuthGuard client:load>
    <div class="p-8">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold text-text-primary">Panel de Administración</h1>
        <button
          id="logout-btn"
          class="px-4 py-2 text-sm bg-surface border border-border rounded-md text-text-secondary hover:text-text-primary hover:border-red-500/50 transition-colors"
        >
          Cerrar sesión
        </button>
      </div>
      <p class="text-text-secondary">Dashboard — próximamente</p>
    </div>
  </AuthGuard>
</AdminLayout>

<script>
  import { signOut } from 'firebase/auth';
  import { auth } from '../../lib/firebase/client';

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'logout-btn') {
      await signOut(auth);
      window.location.href = '/admin/login';
    }
  });
</script>
