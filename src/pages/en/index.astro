---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import TechnologiesSection from '../../components/home/TechnologiesSection.astro';
import { adminDb } from '../../lib/firebase/admin';
import { getAllTechnologies } from '../../lib/firebase/collections';
import { getLocaleFromUrl } from '../../lib/i18n/config';
import { t } from '../../lib/i18n/translations';

const locale = getLocaleFromUrl(Astro.url);
const technologies = await getAllTechnologies(adminDb);
---

<BaseLayout
  title={t('home.meta.title', locale)}
  description={t('home.meta.description', locale)}
  currentPage="home"
>
  <HeroSection locale={locale} />
  <TechnologiesSection technologies={technologies} locale={locale} />
</BaseLayout>
