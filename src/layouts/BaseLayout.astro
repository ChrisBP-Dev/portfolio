---
import '../styles/global.css';
import SkipNav from '../components/common/SkipNav.astro';
import Banner from '../components/layout/Banner.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ThemeScript from '../components/layout/ThemeScript.astro';
import ThemeToggle from '../components/layout/ThemeToggle.svelte';
import LocaleToggle from '../components/layout/LocaleToggle.svelte';
import { t } from '../lib/i18n/translations';
import type { Locale } from '../lib/i18n/config';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'projects' | 'experience' | 'blog' | 'contact';
}

const locale = (Astro.currentLocale ?? 'en') as Locale;
const { title, description = t('meta.description', locale), currentPage = 'home' } = Astro.props;

// Strip locale prefix to get the base route path for hreflang generation
const routePath = locale === 'es'
  ? Astro.url.pathname.replace(/^\/es(\/|$)/, '$1') || '/'
  : Astro.url.pathname;

// Absolute URLs required by Lighthouse SEO hreflang audit
const esHref = new URL(getRelativeLocaleUrl('es', routePath), Astro.url).href;
const enHref = new URL(getRelativeLocaleUrl('en', routePath), Astro.url).href;
---

<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-text-primary min-h-screen flex flex-col">
    <SkipNav locale={locale} />
    <Banner locale={locale} />
    <Header currentPage={currentPage} locale={locale} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ThemeToggle client:load currentLocale={locale} />
    <LocaleToggle client:load currentLocale={locale} currentPath={Astro.url.pathname} />
  </body>
</html>
