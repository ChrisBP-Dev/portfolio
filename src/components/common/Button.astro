---
interface Props {
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const { variant = 'primary', href, type = 'button', disabled = false, class: className, ...attrs } = Astro.props;

const Tag = href ? 'a' : 'button';

const baseClasses = 'min-h-11 min-w-11 px-6 py-3 rounded-lg font-semibold text-body-sm inline-flex items-center justify-center gap-2 transition-all duration-200 focus:outline-2 focus:outline-offset-2 focus:outline-primary';

const variantClasses: Record<string, string> = {
  primary: 'text-white [background:var(--brand-gradient)] shadow-md hover:shadow-lg hover:brightness-110',
  secondary: 'border-2 border-primary text-primary-dark hover:bg-primary/10',
  danger: 'bg-error text-white hover:brightness-110',
  ghost: 'text-text-primary hover:bg-surface-elevated',
};

const disabledClasses = disabled ? 'opacity-50 pointer-events-none' : '';
---

<Tag
  href={!disabled ? href : undefined}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[baseClasses, variantClasses[variant], disabledClasses, className]}
  {...attrs}
>
  <slot />
</Tag>
