---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/cbp-large-logo-dark.png';
import Container from '../common/Container.astro';
import MobileMenu from './MobileMenu.svelte';
import { navItems, localizeHref } from '../../data/navigation';
import type { Locale } from '../../lib/i18n/config';
import { t } from '../../lib/i18n/translations';

interface Props {
  currentPage?: 'home' | 'projects' | 'blog' | 'contact';
  locale: Locale;
}

const { currentPage = 'home', locale } = Astro.props;
---

<header class="sticky top-0 w-full h-16 bg-background/95 backdrop-blur-sm z-50 border-b border-border">
  <Container>
    <div class="flex items-center justify-between h-16">
      <a href={localizeHref('/', locale)} class="flex items-center focus:outline-2 focus:outline-offset-2 focus:outline-primary">
        <Image src={logo} alt="ChrisBP" class="h-10 w-auto" />
      </a>

      <nav class="hidden lg:flex gap-8 items-center" aria-label={t('nav.aria', locale)}>
        {navItems.map((item) => (
          <a
            href={localizeHref(item.href, locale)}
            class:list={[
              'relative text-body-sm font-medium transition-colors min-h-11 flex items-center focus:outline-2 focus:outline-offset-2 focus:outline-primary',
              currentPage === item.key
                ? 'text-primary after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:[background:var(--brand-gradient)]'
                : 'text-text-secondary hover:text-primary',
            ]}
            aria-current={currentPage === item.key ? 'page' : undefined}
          >
            {item.label[locale]}
          </a>
        ))}
      </nav>

      <MobileMenu client:idle currentPage={currentPage} locale={locale} />
    </div>
  </Container>
</header>
