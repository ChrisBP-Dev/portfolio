---
import { Image } from 'astro:assets';
import avatar from '../../assets/logo/cbp-short-logo-dark.png';
import Section from '../common/Section.astro';
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
import { t } from '../../lib/i18n/translations';
import type { Locale } from '../../lib/i18n/config';
import { localizeHref } from '../../data/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const contactHref = localizeHref('/contact', locale);
---

<Section variant="hero">
  <Container variant="narrow">
    <div class="flex flex-col items-center text-center">
      <!-- Circle in background, logo image overlaid on top (no overflow-hidden) -->
      <div class="relative flex justify-center mb-8">
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-32 h-32 rounded-full bg-gradient-to-br from-primary to-primary-dark"></div>
        <Image
          src={avatar}
          alt="ChrisBP"
          class="relative block z-10"
          width={170}
          height={141}
        />
      </div>

      <h1 class="text-display font-bold mb-6">
        {t('home.hero.heading', locale)}{' '}
        <span class="gradient-text">{t('home.hero.headingAccent', locale)}</span>
      </h1>

      <p class="text-body text-text-secondary max-w-[540px] mb-8">
        {t('home.hero.description', locale)}
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <Button variant="primary" href={contactHref}>
          {t('home.hero.cta.contact', locale)}
        </Button>
        <Button variant="secondary" href="/resume.pdf" download>
          {t('home.hero.cta.resume', locale)}
        </Button>
      </div>
    </div>
  </Container>
</Section>
