{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "migrate": "node --env-file=.env --import tsx src/lib/scripts/migrate-firestore-data.ts",
    "seed:experiences": "node --env-file=.env --import tsx src/lib/scripts/seed-experiences.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "dependencies": {
    "@astrojs/svelte": "^8.0.1",
    "astro": "^6.0.5",
    "firebase": "^12.10.0",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
    "svelte": "^5.53.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-svelte": "^3.15.2",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.10.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
