# Firebase Client Config (público — usado en browser)
# En CI/CD: configurar como GitHub Secret FIREBASE_CLIENT_CONFIG (JSON)
PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
PUBLIC_FIREBASE_APP_ID=your-app-id
PUBLIC_ADMIN_UID=your-admin-uid

# Firebase Admin SDK (solo build time — NUNCA en browser)
# En CI/CD: configurar como GitHub Secret FIREBASE_SERVICE_ACCOUNT (JSON)
# En local: necesario solo si ejecutas `pnpm build` localmente
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----"

# Contact
PUBLIC_CONTACT_EMAIL=your-email@example.com
PUBLIC_WHATSAPP_NUMBER=+your-whatsapp-number

# E2E Admin Tests (solo para Playwright E2E tests del admin panel)
E2E_ADMIN_EMAIL=your-admin@example.com
E2E_ADMIN_PASSWORD=your-admin-password

# Emuladores (solo para desarrollo local)
# Activar para conectar SDKs a Firebase Emulator Suite en vez de producción
PUBLIC_USE_EMULATORS=false
USE_EMULATORS=false

# ──────────────────────────────────────────────────────────────
# GitHub Secrets necesarios para CI/CD (configurar en repo Settings > Secrets):
#
# FIREBASE_SERVICE_ACCOUNT — JSON del service account de Firebase Admin SDK
#   Formato: { "project_id": "...", "client_email": "...", "private_key": "..." }
#
# FIREBASE_CLIENT_CONFIG — JSON con config pública del cliente Firebase + app
#   Formato: {
#     "apiKey": "...", "authDomain": "...", "projectId": "...",
#     "storageBucket": "...", "messagingSenderId": "...", "appId": "...",
#     "adminUid": "...", "contactEmail": "...", "whatsappNumber": "..."
#   }
# ──────────────────────────────────────────────────────────────
